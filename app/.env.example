# Copy to .env and fill in. Nothing here has a default that guesses.

# ---------------------------------------------------------------------------
# Gemini. Two backends; set exactly one path.
# ---------------------------------------------------------------------------

# FREE PATH (current). A Gemini Developer API key — the free tier covers
# development at no cost. Get one at https://aistudio.google.com/apikey, or:
#   gcloud services api-keys get-key-string \
#     $(gcloud services api-keys list --project=bidwright-xprize \
#       --format="value(name)" --filter="displayName:BidWright")
GEMINI_API_KEY=

# PAID PATH (before the first real customer). Free-tier prompts may be used to
# improve Google's products, which is fine for public tender PDFs and not fine
# for a customer's proposals, financials or staff resumes. Set GEMINI_USE_VERTEX=1
# and GOOGLE_CLOUD_PROJECT, leave GEMINI_API_KEY empty, and re-enable
# aiplatform.googleapis.com plus billing on the project.
# GEMINI_USE_VERTEX=1
# GOOGLE_CLOUD_PROJECT=bidwright-xprize
# VERTEX_LOCATION=us-central1

# Required on both paths. No default on purpose: model ids change, and a stale
# default fails at runtime in a way that looks like a permissions error. Use a
# current Gemini model — the 1.5 line is long deprecated.
GEMINI_MODEL=

# ---------------------------------------------------------------------------
# Unit economics. Left unset, cost_usd records as 0 and warns rather than
# inventing a rate. On the free tier 0 is the honest number; fill these in the
# moment you move to a paid tier, because the P&L's gross margin depends on it.
# ---------------------------------------------------------------------------
# MODEL_RATES={"<model-id>":{"inputPerMillion":0,"outputPerMillion":0}}
MODEL_RATES=

# ---------------------------------------------------------------------------
# Tuning. All optional.
# ---------------------------------------------------------------------------
# SHRED_CONCURRENCY=2        # raise only on a paid tier; free tier is ~15 RPM
# SHRED_SECTION_CHARS=12000
# PARSE_WINDOW_PAGES=10
# EVAL_MATCH_THRESHOLD=0.6
