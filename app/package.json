{
  "name": "bidwright",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "shred": "node --experimental-strip-types src/eval/shred-one.ts",
    "eval": "node --experimental-strip-types src/eval/run.ts",
    "corpus:fetch": "node --experimental-strip-types src/eval/fetch-corpus.ts",
    "corpus:triage": "node --experimental-strip-types src/eval/triage.ts",
    "labels:verify": "node --experimental-strip-types src/eval/verify-labels.ts"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.10.0",
    "@google/genai": "^0.14.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.9.155"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3"
  }
}
